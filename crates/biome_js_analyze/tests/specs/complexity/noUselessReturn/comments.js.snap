    if (condition) {
        // nothing else to do here
        return;
    }
}

// the comment that trails the removed return is kept
function c() {
    return; // nothing else to do here
}

// the comment that leads the removed return at the end of a block is kept
function d() {
    doSomething();
    // nothing left to do
    return;
}

```

